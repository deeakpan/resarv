# Deployer for Hardhat scripts
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Robinhood Chain (primary) — chainId 4663
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_DEFAULT_CHAIN_ID=4663

# Somnia Testnet (optional) — Shannon, chainId 50312
SOMNIA_TESTNET_RPC=https://api.infra.testnet.somnia.network
RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_SOMNIA_TESTNET_RPC=https://api.infra.testnet.somnia.network

# Optional other networks
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Reown Cloud project id (dashboard.reown.com)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# NFT CDP signed floor oracle (server-only; must match on-chain priceSigner)
PRICE_SIGNER_PRIVATE_KEY=0xYOUR_PRICE_SIGNER_KEY
PRICE_SIGNER_ADDRESS=0xYOUR_PRICE_SIGNER_ADDRESS
TREASURY_ADDRESS=0xYOUR_TREASURY
DEFAULT_NFT_FLOOR_USD=1000000000000000000000
DEPLOY_MOCK_NFT=0
MOCK_NFT_MINT_COUNT=0
# Leave 0 at launch; later set RSRV_TOKEN_ADDRESS and run scripts/enable-staking.ts
DEPLOY_STAKING=0
SUPPORTED_COLLECTIONS=

# DEMO=1 → sign mock NFT at live Stonk Brokers OpenSea floor
DEMO=0
NEXT_PUBLIC_DEMO=0
