# Deployer key for Robinhood Chain (testnet first). Never commit the real key.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional RPC overrides. Defaults are the public Robinhood endpoints.
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
