# Secrets and RPC only. Contract addresses live in deployments/addresses.json
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
RPC_URL=https://unichain-sepolia-rpc.publicnode.com

# Same wallet as deployer
TREASURY=
DEV=

# Reown Cloud project id (dashboard.reown.com). Dummy zeros 403 AppKit.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Demo: mintable testnet NFTs mapped to real OpenSea collection art.
NEXT_PUBLIC_DEMO=true
